<?xml version="1.0" encoding="UTF-8"?>
<!--
  华电学生手册 RAG 智能问答系统 · Java 业务服务（P01：工程骨架与契约冻结）

  构建工具 = Maven（用户决策 UD-09，不用 Gradle）。
  proto 契约唯一来源 = 仓库根 ../proto/rag_service.proto，本模块只引用不复制。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.ncepu.rag</groupId>
  <artifactId>java-service</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>java-service</name>
  <description>华电学生手册 RAG 智能问答系统 · Java 业务服务</description>

  <properties>
    <java.version>21</java.version>
    <!-- Q-22：两侧 protoc 主版本必须一致，见 docs/03 §2.3 与 python-rag/tests/test_proto_version_match.py -->
    <protoc.version>3.25.1</protoc.version>
    <grpc.version>1.65.1</grpc.version>
    <protobuf.version>3.25.1</protobuf.version>
    <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
    <!--
      ★ 关闭 Maven 增量编译。

      protoc 每次生成的是**整套**消息类（ChatChunk、它的 Builder、以及 javac 合成的
      内部访问器 access$N）。只要有一次生成与编译不同步，就会出现：
        NoSuchMethodError: 'boolean com.ncepu.rag.grpc.ChatChunk.access$7()'
        NoClassDefFoundError / ClassNotFoundException
      这类错误只在流式反序列化时才炸，看起来像协议问题，实则构建产物脏了。

      项目类不多（几十个），全量编译只多几秒，换来"构建结果只取决于源码"。
    -->
    <maven.compiler.useIncrementalCompilation>false</maven.compiler.useIncrementalCompilation>
    <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- gRPC：运行时 + 生成代码依赖 -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <version>${grpc.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
      <version>${protobuf.version}</version>
    </dependency>
    <!-- protoc 生成的 gRPC Stub 用到 @javax.annotation.Generated（源码级注解，provided 即可） -->
    <dependency>
      <groupId>javax.annotation</groupId>
      <artifactId>javax.annotation-api</artifactId>
      <version>1.3.2</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <extensions>
      <!-- 提供 ${os.detected.classifier}，protobuf-maven-plugin 靠它挑选本机 protoc 可执行文件 -->
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>${os-maven-plugin.version}</version>
      </extension>
    </extensions>

    <plugins>
      <!-- 编译期生成：Java 消息类 + gRPC Stub（mvn generate-sources 即可单独验证） -->
      <plugin>
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <version>${protobuf-maven-plugin.version}</version>
        <configuration>
          <!-- 只编译本服务自己的契约，不复制进本模块（单一来源原则） -->
          <protoSourceRoot>${project.basedir}/../proto</protoSourceRoot>
          <protocArtifact>com.google.protobuf:protoc:${protoc.version}:exe:${os.detected.classifier}</protocArtifact>
          <pluginId>grpc-java</pluginId>
          <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
              <goal>compile-custom</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- 保留方法参数名，后续 Controller 的参数绑定与校验消息需要 -->
          <parameters>true</parameters>
        </configuration>
      </plugin>

      <!--
        ★ 必须显式包含 **/*IT.java。

        Surefire 默认只匹配 *Test / Test* / *Tests / *TestCase，名字以 IT 结尾的
        集成用例**一个都不会执行**——而脚本又打印"集成用例通过"，形成典型的假绿。
        P02 首次联调就踩了：verify-p02.sh 第 4 步全绿，实际 RagServiceClientIT 从未运行。

        这些 IT 自身用 @EnabledIfSystemProperty 控制是否启用（默认跳过），
        所以加进 surefire 不会让日常 `mvn test` 变慢，也不会在无服务环境下失败。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/Test*.java</include>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
      </plugin>

      <!-- 打可执行 fat jar（java -jar 启动）；缺它则 jar 无 Main-Class，无法验证「启动即校验」 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
