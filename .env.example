# =============================================================================
# 环境变量样例（P01）——复制为 .env 后填写，.env 不入 Git
#
# 约定：
#   · Secret 类值**留空**，由部署环境注入（NFR-12 / NFR-13）；
#   · 必填项缺失时两个服务都会**启动失败并报出变量名**，不存在静默默认值；
#   · 变量清单来源：docs/03-详细设计技术方案.md §9.1（Java）与 §9.2（Python）。
#   · 占位值仅供本地联调，任何时候都不得写真实生产密钥。
# =============================================================================

# -----------------------------------------------------------------------------
# Java 侧（java-service）
# -----------------------------------------------------------------------------
JAVA_DB_URL=jdbc:mysql://127.0.0.1:3306/student_rag
JAVA_DB_USER=rag_app
JAVA_DB_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_SECONDS=7200
JWT_BLACKLIST_ENABLED=false

RAG_HOST=127.0.0.1
RAG_PORT=50051
RAG_TLS_ENABLED=true
RAG_TLS_CA_PATH=/etc/rag/ca.pem
RAG_TLS_OVERRIDE_AUTHORITY=
RAG_CHAT_TIMEOUT_MS=180000
RAG_INGEST_TIMEOUT_MS=300000
RAG_UNARY_TIMEOUT_MS=10000

HMAC_KEY_ID=k1
HMAC_SECRET=
HMAC_CLOCK_SKEW_SECONDS=60

SSE_TIMEOUT_MS=180000
SSE_HEARTBEAT_MS=15000
SPRING_THREADS_VIRTUAL_ENABLED=true
CHAT_QUESTION_MAX_LEN=500
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_EXT=md,txt
UPLOAD_CHUNK_BYTES=524288

RATELIMIT_ENABLED=true
RATELIMIT_CHAT_PER_MIN=20
RATELIMIT_LOGIN_PER_MIN=10

LOG_LEVEL=INFO
SERVER_PORT=8080

# -----------------------------------------------------------------------------
# Python 侧（rag-service）
# -----------------------------------------------------------------------------
GRPC_PORT=50051
GRPC_TLS_CERT_PATH=/etc/rag/server.pem
GRPC_TLS_KEY_PATH=/etc/rag/server.key
NONCE_CACHE_MAX=20000

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=campus_policy_chunks
DOC_STORAGE_DIR=./storage/documents

# Embedding：默认云端（UD-05）；模型具体选型待确认 Q-02，禁止硬编码向量维度
EMBEDDING_PROVIDER=cloud
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BATCH_SIZE=32

# LLM：厂商已定 DeepSeek（Q-01 仅剩 Key 归属与配额）
LLM_PROVIDER=cloud
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_CONNECT=10
LLM_TIMEOUT_FIRST_TOKEN=30
LLM_TIMEOUT_TOTAL=120

RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
CHUNK_MIN_TOKENS=60
SKILL_NAME=campus-policy-qa

# -----------------------------------------------------------------------------
# 本地 Compose 专用（docker-compose.java.yml / docker-compose.python.yml）
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=student_rag
